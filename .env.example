# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Gemini API key from https://aistudio.google.com/apikey (GOOGLE_API_KEY also works).
# Only the web app and the `paperpilot review` / `paperpilot plan` commands need it.
GEMINI_API_KEY=

# Optional: Gemini model id. Leave empty for the default (gemini-3.8-flash).
PAPERPILOT_MODEL=
